# API Backend
VITE_API_URL=http://localhost:8000/api

# MinIO (armazenamento de imagens)
VITE_MINIO_PUBLIC_URL=http://localhost:9000

# Google OAuth
VITE_GOOGLE_CLIENT_ID=seu_google_client_id_aqui

# Stripe (Publishable Key — nunca usar Secret Key no frontend)
VITE_STRIPE_PUBLIC_KEY=pk_test_sua_chave_publishable_aqui

# WebSocket (derivado automaticamente de VITE_API_URL — documentado para referência)
VITE_WS_URL=wss://api.sua-url.com
