    MarketplaceListingUpdate:
      type: object
      description: |-
        Serializer para atualizar listagem.

        O campo `packages` é opcional. Quando fornecido, substitui completamente
        os pacotes existentes do listing (delete + bulk_create).
        Os campos legados de dimensão foram removidos da atualização.
      properties:
        title:
          type: string
          description: Título do anúncio
          maxLength: 150
        price:
          type: string
          format: decimal
          pattern: ^-?\d{0,8}(?:\.\d{0,2})?$
        quantity:
          type: integer
          maximum: 2147483647
          minimum: 0
        description:
          type: string
          maxLength: 255
        condition:
          type: integer
        is_active:
          type: boolean
        shipping_address:
          type: integer
          nullable: true
          description: Endereço de envio do anúncio
        shipping_method:
          allOf:
          - $ref: '#/components/schemas/ShippingMethodEnum'
          description: |-
            Método de envio aceito pelo vendedor para este anúncio. 'in_person' = somente entrega presencial; 'melhor_envio' = somente via transportadora; 'both' = ambos os métodos são aceitos.

            * `in_person` - Somente Entrega Presencial
            * `melhor_envio` - Somente Melhor Envio
            * `both` - Ambos (Presencial e Melhor Envio)
      required:
      - condition
      - description
      - price
      - title
    MarketplaceListingUpdateRequest:
      type: object
      description: |-
        Serializer para atualizar listagem.

        O campo `packages` é opcional. Quando fornecido, substitui completamente
        os pacotes existentes do listing (delete + bulk_create).
        Os campos legados de dimensão foram removidos da atualização.
      properties:
        title:
          type: string
          minLength: 1
          description: Título do anúncio
          maxLength: 150
        price:
          type: string
          format: decimal
          pattern: ^-?\d{0,8}(?:\.\d{0,2})?$
        quantity:
          type: integer
          maximum: 2147483647
          minimum: 0
        description:
          type: string
          minLength: 1
          maxLength: 255
        condition:
          type: integer
        is_active:
          type: boolean
        shipping_address:
          type: integer
          nullable: true
          description: Endereço de envio do anúncio
        packages:
          type: array
          items:
            $ref: '#/components/schemas/ListingPackageRequest'
          writeOnly: true
          description: Lista de pacotes físicos. Quando fornecido, substitui todos
            os pacotes existentes do anúncio.
        shipping_method:
          allOf:
          - $ref: '#/components/schemas/ShippingMethodEnum'
          description: |-
            Método de envio aceito pelo vendedor para este anúncio. 'in_person' = somente entrega presencial; 'melhor_envio' = somente via transportadora; 'both' = ambos os métodos são aceitos.

            * `in_person` - Somente Entrega Presencial
            * `melhor_envio` - Somente Melhor Envio
            * `both` - Ambos (Presencial e Melhor Envio)
      required:
      - condition
      - description
      - price
      - title
    MeetingStatusEnum:
      enum:
      - pending_schedule
      - scheduled
      - confirmed
      - in_progress
      - completed
      - cancelled
      - no_show
      type: string
      description: |-
        * `pending_schedule` - Aguardando Agendamento
        * `scheduled` - Agendado
        * `confirmed` - Confirmado por Ambas as Partes
        * `in_progress` - Em Andamento
        * `completed` - Concluído
        * `cancelled` - Cancelado
        * `no_show` - Não Compareceu
    MelhorEnvioItem:
      type: object
      properties:
        listing_id:
          type: integer
        title:
          type: string
        shipping_method:
          type: string
      required:
      - listing_id
      - shipping_method
      - title
    MelhorEnvioWebhookPayloadRequest:
      type: object
      properties:
        event:
          type: string
          minLength: 1
        data:
          type: object
          additionalProperties: {}
      required:
      - data
      - event
    OAuthAuthorizeResponse:
      type: object
      properties:
        authorization_url:
          type: string
          format: uri
        environment:
          type: string
        instructions:
          type: string
      required:
      - authorization_url
      - environment
      - instructions
    OAuthCallbackGetResponse:
      type: object
      properties:
        message:
          type: string
        token_status:
          type: object
          additionalProperties: {}
          nullable: true
      required:
      - message
      - token_status
    OAuthCallbackPostResponse:
      type: object
      properties:
        message:
          type: string
        token_status:
          type: object
          additionalProperties: {}
          nullable: true
      required:
      - message
      - token_status
    OAuthTokenStatusResponse:
      type: object
