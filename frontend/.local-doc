          description: ''
  /api/orders/create/:
    post:
      operationId: orders_create_create
      description: |-
        Create an order from the cart. Delivery method is chosen **per item** (listing), not per seller.

        ## Fields

        **`items_delivery`** (required): List with one entry per cart item.
        - `listing_id`: ID of the listing in the cart
        - `delivery_method`: `'melhor_envio'` or `'in_person'`
        - `service_id`: Required when `delivery_method='melhor_envio'`. Must match a service in a valid (non-expired) ShippingQuote for that seller.

        **Listing constraints** — `delivery_method` must respect `listing.shipping_method`:
        - `in_person` listing → must choose `'in_person'`
        - `melhor_envio` listing → must choose `'melhor_envio'`
        - `both` listing → either is valid

        **`in_person_by_seller`** (optional): Meeting details per seller_id (string key).
        All sub-fields are optional — can be filled later via update endpoint:
        `meeting_location_name`, `meeting_address`, `seller_contact_phone`, `buyer_contact_phone`, `scheduled_date`, `scheduled_time`, `meeting_notes`

        ## Internal Conversion

        The API converts `items_delivery` + `in_person_by_seller` into an internal per-seller format before processing:
        - Seller with only `melhor_envio` items → `shipping` delivery
        - Seller with only `in_person` items → `in_person` delivery
        - Seller with mixed items → `split` delivery

        ## Shipping Cost

        Costs are always taken from the server-side ShippingQuote — never from client input.
      summary: Create order
      tags:
      - Orders
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/OrderCreateRequestRequest'
            examples:
              MixedCart:Listing30(both→melhorEnvio)+Listing31(inPerson):
                value:
                  shipping_address_id: 5
                  items_delivery:
                  - listing_id: 30
                    delivery_method: melhor_envio
                    service_id: 3
                  - listing_id: 31
                    delivery_method: in_person
                  in_person_by_seller:
                    '9':
                      meeting_location_name: Shopping Iguatemi
                      meeting_address:
                        street: Av. Brigadeiro Faria Lima
                        number: '2232'
                        city: São Paulo
                        state: SP
                        zipcode: 01451-000
                      seller_contact_phone: '11999999999'
                      buyer_contact_phone: '11888888888'
                      scheduled_date: '2026-03-10'
                      scheduled_time: '14:00'
                      meeting_notes: Próximo à entrada principal
                  payment_method: pix
                  buyer_notes: ''
                summary: 'Mixed cart: listing 30 (both→melhor_envio) + listing 31
                  (in_person)'
                description: 'Seller 9 has two listings: listing 30 (shipping_method=both)
                  chosen for Melhor Envio delivery, and listing 31 (shipping_method=in_person)
                  for in-person. This produces a split delivery internally.'
              AllMelhorEnvio:
                value:
                  shipping_address_id: 5
                  items_delivery:
                  - listing_id: 10
                    delivery_method: melhor_envio
                    service_id: 2
                  - listing_id: 20
                    delivery_method: melhor_envio
                    service_id: 1
                  in_person_by_seller: {}
                  payment_method: credit_card
                  buyer_notes: ''
                summary: All Melhor Envio
                description: All cart items shipped via Melhor Envio (two sellers)
              AllIn-person:
                value:
                  shipping_address_id: 5
                  items_delivery:
                  - listing_id: 10
                    delivery_method: in_person
                  - listing_id: 20
                    delivery_method: in_person
                  in_person_by_seller:
                    '1':
                      meeting_location_name: Loja Física Centro
                      meeting_address:
                        street: Rua Augusta
                        number: '100'
                        city: São Paulo
                        state: SP
                        zipcode: 01304-000
                      seller_contact_phone: '11999999999'
                      buyer_contact_phone: '11888888888'
                    '2': {}
                  payment_method: pix
                  buyer_notes: ''
                summary: All in-person
                description: All cart items picked up in-person with meeting details
              SplitWithIn-personMeetingDetails:
                value:
                  shipping_address_id: 5
                  items_delivery:
                  - listing_id: 30
                    delivery_method: melhor_envio
                    service_id: 3
                  - listing_id: 31
                    delivery_method: in_person
                  in_person_by_seller:
                    '9':
                      meeting_location_name: Portaria do Condomínio
                      seller_contact_phone: '11912345678'
                      buyer_contact_phone: '11987654321'
                      scheduled_date: '2026-03-15'
                      scheduled_time: '10:00'
                  payment_method: pix
                  buyer_notes: Ligar antes de chegar
                summary: Split with in-person meeting details
                description: Seller 9 has listing 30 (both → melhor_envio, service
                  3) and listing 31 (in_person). Meeting details provided for in-person
                  items.
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/OrderCreateRequestRequest'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/OrderCreateRequestRequest'
        required: true
      security:
      - JWTAuthentication: []
        JWTCookieAuthentication: []
      responses:
        '201':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Order'
          description: ''
