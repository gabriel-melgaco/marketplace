            $ref: '#/components/schemas/SocialAccount'
    PasswordChange:
      type: object
      description: Password change for authenticated users.
      properties:
        detail:
          type: string
          readOnly: true
      required:
      - detail
    PasswordChangeRequest:
      type: object
      description: Password change for authenticated users.
      properties:
        new_password1:
          type: string
          writeOnly: true
          minLength: 1
          maxLength: 128
        new_password2:
          type: string
          writeOnly: true
          minLength: 1
          maxLength: 128
      required:
      - new_password1
      - new_password2
    PasswordReset:
      type: object
      description: Password reset request with email verification.
      properties:
        detail:
          type: string
          readOnly: true
      required:
      - detail
    PasswordResetConfirm:
      type: object
      description: Password reset confirmation with new password.
      properties:
        detail:
          type: string
          readOnly: true
      required:
      - detail
    PasswordResetConfirmRequest:
      type: object
      description: Password reset confirmation with new password.
      properties:
        new_password1:
          type: string
          writeOnly: true
          minLength: 1
          maxLength: 128
        new_password2:
          type: string
          writeOnly: true
          minLength: 1
          maxLength: 128
        uid:
          type: string
          writeOnly: true
          minLength: 1
        token:
          type: string
          writeOnly: true
          minLength: 1
      required:
      - new_password1
      - new_password2
      - token
      - uid
    PasswordResetRequest:
      type: object
      description: Password reset request with email verification.
      properties:
        email:
          type: string
          format: email
          writeOnly: true
          minLength: 1
      required:
      - email
    PatchedAddressCreateRequest:
      type: object
      description: Serializer para criar endereço
      properties:
        address_type:
          $ref: '#/components/schemas/AddressTypeEnum'
        nickname:
          type: string
          maxLength: 50
        recipient_name:
          type: string
          minLength: 1
          maxLength: 200
        recipient_phone:
          type: string
          minLength: 1
          maxLength: 20
        zipcode:
          type: string
          minLength: 1
          maxLength: 9
        street:
          type: string
          minLength: 1
          maxLength: 200
        number:
          type: string
          minLength: 1
          maxLength: 20
        complement:
          type: string
          maxLength: 100
        neighborhood:
          type: string
          minLength: 1
          maxLength: 100
        city:
          type: string
          minLength: 1
          maxLength: 100
        state:
          type: string
          minLength: 1
          maxLength: 2
        is_default:
          type: boolean
        is_shipping_address:
          type: boolean
    PatchedCustomUserRequest:
      type: object
      description: |-
        Valida CPF/CNPJ:
        - formato
        - dígitos verificadores
        - unicidade
        - suporta create e update
      properties:
        email:
          type: string
          format: email
          minLength: 1
          maxLength: 254
        full_name:
          type: string
          minLength: 1
          maxLength: 50
        birthday:
          type: string
          format: date
          nullable: true
        cpf:
          type: string
          nullable: true
          maxLength: 14
        picture:
          type: string
          nullable: true
          maxLength: 255
        is_active:
          type: boolean
          title: Ativo
          description: Indica que o usuário será tratado como ativo. Ao invés de excluir
            contas de usuário, desmarque isso.
    PatchedInPersonDeliveryUpdateRequest:
      type: object
      description: Serializer para atualizar entrega presencial
      properties:
        meeting_status:
          $ref: '#/components/schemas/MeetingStatusEnum'
        meeting_location_name:
          type: string
          description: 'Nome do local (ex: Shopping X, Estação Y)'
          maxLength: 200
        meeting_address:
          description: Endereço completo do local de encontro
        meeting_notes:
          type: string
          description: 'Observações sobre o local (ex: próximo à entrada principal)'
        scheduled_date:
          type: string
          format: date
          nullable: true
          description: Data agendada para o encontro
        scheduled_time:
          type: string
          format: time
          nullable: true
          description: Horário agendado para o encontro
        completion_notes:
          type: string
          description: Observações sobre a conclusão da entrega
    PatchedListingPackageRequest:
      type: object
      description: |-
        Serializer para pacotes de um anúncio (ListingPackage).

        Valida que todas as dimensões e peso são maiores que zero.
        Usado como nested serializer em criação/atualização de listings
        e como serializer standalone nos endpoints /packages/.
      properties:
        weight_kg:
          type: string
          format: decimal
          pattern: ^-?\d{0,4}(?:\.\d{0,2})?$
          description: Peso do pacote em kg
        height_cm:
          type: string
          format: decimal
          pattern: ^-?\d{0,4}(?:\.\d{0,2})?$
          description: Altura do pacote em cm
        width_cm:
          type: string
          format: decimal
          pattern: ^-?\d{0,4}(?:\.\d{0,2})?$
          description: Largura do pacote em cm
        length_cm:
          type: string
          format: decimal
          pattern: ^-?\d{0,4}(?:\.\d{0,2})?$
          description: Comprimento do pacote em cm
        description:
          type: string
          description: 'Descrição opcional do pacote (ex: ''Caixa grande'')'
          maxLength: 100
    PatchedMarketplaceListingImageRequest:
      type: object
      description: Serializer de imagens de listagem
      properties:
        image_url:
          type: string
          format: uri
          minLength: 1
          maxLength: 500
        object_name:
          type: string
          minLength: 1
          maxLength: 255
        is_primary:
          type: boolean
        order:
          type: integer
          maximum: 32767
          minimum: 0
        listing:
          type: integer
    PatchedMarketplaceListingUpdateRequest:
      type: object
      description: |-
        Serializer para atualizar listagem.

        O campo `packages` é opcional. Quando fornecido, substitui completamente
        os pacotes existentes do listing (delete + bulk_create).
        Os campos legados de dimensão foram removidos da atualização.
      properties:
        title:
          type: string
          minLength: 1
          description: Título do anúncio
          maxLength: 150
        price:
          type: string
          format: decimal
          pattern: ^-?\d{0,8}(?:\.\d{0,2})?$
        quantity:
          type: integer
          maximum: 2147483647
          minimum: 0
        description:
          type: string
          minLength: 1
          maxLength: 255
        condition:
          type: integer
        is_active:
          type: boolean
        shipping_address:
          type: integer
          nullable: true
          description: Endereço de envio do anúncio
        packages:
          type: array
          items:
            $ref: '#/components/schemas/ListingPackageRequest'
          writeOnly: true
          description: Lista de pacotes físicos. Quando fornecido, substitui todos
            os pacotes existentes do anúncio.
        shipping_method:
          allOf:
          - $ref: '#/components/schemas/ShippingMethodEnum'
          description: |-
            Método de envio aceito pelo vendedor para este anúncio. 'in_person' = somente entrega presencial; 'melhor_envio' = somente via transportadora; 'both' = ambos os métodos são aceitos.

            * `in_person` - Somente Entrega Presencial
            * `melhor_envio` - Somente Melhor Envio
            * `both` - Ambos (Presencial e Melhor Envio)
    PatchedUpdateCartItemRequestRequest:
      type: object
      properties:
        quantity:
          type: integer
          minimum: 1
    Payment:
      type: object
      description: Serializer completo de pagamento
      properties:
        id:
          type: integer
          readOnly: true
        order:
          type: string
          format: uuid
        order_number:
          type: string
          readOnly: true
        user:
          type: integer
        user_email:
          type: string
          format: email
          readOnly: true
        stripe_payment_intent_id:
          type: string
          readOnly: true
        stripe_charge_id:
          type: string
          readOnly: true
        amount:
          type: string
          format: decimal
          pattern: ^-?\d{0,8}(?:\.\d{0,2})?$
        currency:
          type: string
          maxLength: 3
        status:
          allOf:
          - $ref: '#/components/schemas/PaymentStatusEnum'
          readOnly: true
        payment_method:
          $ref: '#/components/schemas/PaymentMethodEnum'
        description:
          type: string
        failure_message:
          type: string
          readOnly: true
        receipt_url:
          type: string
          format: uri
          readOnly: true
        refund_amount:
          type: string
          format: decimal
          pattern: ^-?\d{0,8}(?:\.\d{0,2})?$
          nullable: true
        refund_reason:
          type: string
        refunded_at:
          type: string
          format: date-time
          readOnly: true
          nullable: true
        created_at:
          type: string
          format: date-time
          readOnly: true
        updated_at:
          type: string
          format: date-time
          readOnly: true
        paid_at:
          type: string
          format: date-time
          readOnly: true
          nullable: true
      required:
      - amount
      - created_at
      - failure_message
      - id
      - order
      - order_number
      - paid_at
      - payment_method
      - receipt_url
      - refunded_at
      - status
      - stripe_charge_id
      - stripe_payment_intent_id
      - updated_at
      - user
      - user_email
    PaymentConfirmRequest:
      type: object
      description: Serializer para confirmar pagamento
      properties:
        payment_intent_id:
          type: string
          minLength: 1
        payment_method_id:
          type: string
          minLength: 1
      required:
      - payment_intent_id
    PaymentIntentCreateRequest:
      type: object
      description: Serializer para criar Payment Intent no Stripe
      properties:
        order_id:
          type: string
          format: uuid
        payment_method:
          $ref: '#/components/schemas/PaymentMethod1baEnum'
        save_payment_method:
          type: boolean
          default: false
      required:
      - order_id
      - payment_method
    PaymentMethod1baEnum:
      enum:
      - credit_card
      - debit_card
      - pix
      - boleto
      type: string
      description: |-
        * `credit_card` - credit_card
        * `debit_card` - debit_card
        * `pix` - pix
        * `boleto` - boleto
    PaymentMethodEnum:
      enum:
      - credit_card
      - debit_card
      - pix
      - boleto
      type: string
      description: |-
        * `credit_card` - Cartão de Crédito
        * `debit_card` - Cartão de Débito
        * `pix` - PIX
        * `boleto` - Boleto
    PaymentStatusEnum:
      enum:
      - pending
      - processing
      - succeeded
      - failed
      - cancelled
      - refunded
      type: string
      description: |-
        * `pending` - Pendente
        * `processing` - Processando
        * `succeeded` - Sucesso
        * `failed` - Falhou
        * `cancelled` - Cancelado
        * `refunded` - Reembolsado
    PresignedUrlRequest:
      type: object
      properties:
        file_name:
          type: string
          minLength: 1
        content_type:
          type: string
          minLength: 1
      required:
      - content_type
      - file_name
    PresignedUrlResponse:
      type: object
      properties:
        upload_url:
          type: string
          format: uri
        object_name:
          type: string
        file_url:
          type: string
          format: uri
      required:
      - file_url
      - object_name
      - upload_url
    Product:
      type: object
      description: Serializer completo de produto
      properties:
        id:
          type: integer
          readOnly: true
        category:
          allOf:
          - $ref: '#/components/schemas/CategorySimple'
          readOnly: true
        series:
          allOf:
          - $ref: '#/components/schemas/SeriesSimple'
          readOnly: true
        name:
          type: string
          maxLength: 200
        slug:
          type: string
          maxLength: 100
          pattern: ^[-a-zA-Z0-9_]+$
        code:
          type: string
          nullable: true
          maxLength: 100
        image_url:
          type: string
          format: uri
          maxLength: 500
        description:
          type: string
      required:
      - category
      - id
      - name
      - series
      - slug
    ProductSimple:
      type: object
      description: Serializer simples de produto
      properties:
        id:
          type: integer
          readOnly: true
        name:
          type: string
          maxLength: 200
        slug:
          type: string
          maxLength: 100
          pattern: ^[-a-zA-Z0-9_]+$
        code:
          type: string
          nullable: true
          maxLength: 100
        image_url:
          type: string
          format: uri
          maxLength: 500
      required:
      - id
      - name
      - slug
    RefundRequest:
      type: object
      description: Serializer para solicitar reembolso
      properties:
        payment_id:
          type: integer
        amount:
          type: string
          format: decimal
          pattern: ^-?\d{0,8}(?:\.\d{0,2})?$
        reason:
          type: string
      required:
      - payment_id
    ResendEmailVerification:
      type: object
      description: Request new email verification message.
      properties:
        detail:
          type: string
          readOnly: true
      required:
      - detail
    ResendEmailVerificationRequest:
      type: object
      description: Request new email verification message.
      properties:
        email:
          type: string
          format: email
          writeOnly: true
          minLength: 1
      required:
      - email
    SearchProductsResponse:
      type: object
      properties:
        results:
          type: array
          items:
            $ref: '#/components/schemas/MarketplaceListing'
      required:
      - results
    SellerMECallbackResponse:
      type: object
      properties:
        message:
          type: string
        me_email:
          type: string
          format: email
          nullable: true
        environment:
          type: string
      required:
      - environment
      - me_email
      - message
    SellerMEConnectResponse:
      type: object
      properties:
        authorization_url:
          type: string
          format: uri
        message:
          type: string
        environment:
          type: string
      required:
      - authorization_url
      - environment
      - message
    SellerMEDisconnectResponse:
      type: object
      properties:
        message:
          type: string
        disconnected:
          type: boolean
      required:
      - disconnected
      - message
    SellerMEStatusResponse:
      type: object
      properties:
        connected:
          type: boolean
        environment:
          type: string
        me_email:
          type: string
          format: email
          nullable: true
        access_token:
          type: string
          nullable: true
        is_expired:
          type: boolean
          nullable: true
        expires_at:
          type: string
          nullable: true
        expires_in_seconds:
          type: integer
          nullable: true
        is_refresh_token_expired:
          type: boolean
          nullable: true
        last_refreshed_at:
          type: string
          nullable: true
        message:
          type: string
      required:
      - connected
      - environment
    SellerPayout:
      type: object
      description: Serializer de repasse ao vendedor
      properties:
        id:
          type: integer
          readOnly: true
        seller:
          type: integer
        seller_email:
          type: string
          format: email
          readOnly: true
        order:
          type: string
          format: uuid
        order_number:
          type: string
          readOnly: true
        gross_amount:
          type: string
          format: decimal
          pattern: ^-?\d{0,8}(?:\.\d{0,2})?$
        platform_fee:
          type: string
          format: decimal
          pattern: ^-?\d{0,8}(?:\.\d{0,2})?$
        net_amount:
          type: string
          format: decimal
          pattern: ^-?\d{0,8}(?:\.\d{0,2})?$
        status:
          $ref: '#/components/schemas/SellerPayoutStatusEnum'
        stripe_transfer_id:
          type: string
          maxLength: 255
        created_at:
          type: string
          format: date-time
          readOnly: true
        scheduled_for:
          type: string
          format: date-time
        paid_at:
          type: string
          format: date-time
          nullable: true
      required:
      - created_at
      - gross_amount
      - id
      - net_amount
      - order
      - order_number
      - platform_fee
      - scheduled_for
      - seller
      - seller_email
    SellerPayoutStatusEnum:
      enum:
      - pending
      - processing
      - completed
      - failed
      type: string
      description: |-
        * `pending` - Pendente
        * `processing` - Processando
        * `completed` - Concluído
        * `failed` - Falhou
    SellerQuoteEntry:
      type: object
      properties:
        services:
          type: array
          items:
            type: object
            additionalProperties: {}
          description: Lista de serviços de frete disponíveis (apenas itens elegíveis)
        melhor_envio_items:
          type: array
          items:
            $ref: '#/components/schemas/MelhorEnvioItem'
          description: Itens incluídos no cálculo de frete via Melhor Envio
        in_person_items:
          type: array
          items:
            $ref: '#/components/schemas/InPersonItem'
          description: Itens excluídos do cálculo por terem shipping_method=in_person
        in_person_only:
          type: boolean
          description: True quando TODOS os itens do vendedor são in_person
        error:
          type: string
          description: Mensagem de erro se o cálculo falhou para este vendedor
      required:
      - services
    SellerQuoteMap:
      type: object
      properties:
        seller_id:
          $ref: '#/components/schemas/SellerQuoteEntry'
      required:
      - seller_id
    Series:
      type: object
      description: Serializer completo de série
      properties:
        id:
          type: integer
          readOnly: true
        name:
          type: string
          maxLength: 100
        slug:
          type: string
          maxLength: 50
          pattern: ^[-a-zA-Z0-9_]+$
      required:
      - id
      - name
      - slug
    SeriesSimple:
      type: object
      description: Serializer simples de série
      properties:
        id:
          type: integer
          readOnly: true
        name:
          type: string
          maxLength: 100
        slug:
          type: string
          maxLength: 50
          pattern: ^[-a-zA-Z0-9_]+$
      required:
      - id
      - name
      - slug
    SetPrimaryImageResponse:
      type: object
      properties:
        message:
          type: string
      required:
      - message
    Shipment:
      type: object
      description: Serializer completo de envio
      properties:
        id:
          type: integer
          readOnly: true
        order:
          type: string
          format: uuid
        order_number:
          type: string
          readOnly: true
        melhorenvio_order_id:
          type: string
          maxLength: 255
        melhorenvio_order_ids:
          description: Lista de IDs ME quando o listing possui múltiplos pacotes (1
            chamada por pacote).
        melhorenvio_tracking_code:
          type: string
          maxLength: 255
        melhorenvio_tracking_codes:
          description: Lista de tracking codes ME (um por pacote físico). melhorenvio_tracking_code
            mantém o primeiro para retrocompatibilidade.
        carrier_name:
          type: string
          maxLength: 100
        carrier_service:
          type: string
          maxLength: 100
        shipping_cost:
          type: string
          format: decimal
          pattern: ^-?\d{0,8}(?:\.\d{0,2})?$
        insurance_value:
          type: string
          format: decimal
          pattern: ^-?\d{0,8}(?:\.\d{0,2})?$
        status:
          $ref: '#/components/schemas/ShipmentStatusEnum'
        tracking_url:
          type: string
          format: uri
          maxLength: 200
        weight:
          type: string
          format: decimal
          pattern: ^-?\d{0,4}(?:\.\d{0,2})?$
        height:
          type: string
          format: decimal
          pattern: ^-?\d{0,4}(?:\.\d{0,2})?$
        width:
          type: string
          format: decimal
          pattern: ^-?\d{0,4}(?:\.\d{0,2})?$
        length:
          type: string
          format: decimal
          pattern: ^-?\d{0,4}(?:\.\d{0,2})?$
        origin_address: {}
        destination_address: {}
        label_url:
          type: string
          format: uri
          maxLength: 200
        label_generated_at:
          type: string
          format: date-time
          nullable: true
        estimated_delivery_date:
          type: string
          format: date
          nullable: true
        created_at:
          type: string
          format: date-time
          readOnly: true
        updated_at:
          type: string
          format: date-time
          readOnly: true
        posted_at:
          type: string
          format: date-time
          nullable: true
        delivered_at:
          type: string
          format: date-time
          nullable: true
        tracking_history:
          type: array
          items:
            $ref: '#/components/schemas/ShipmentTracking'
          readOnly: true
      required:
      - carrier_name
      - carrier_service
      - created_at
      - destination_address
      - height
      - id
      - length
      - melhorenvio_order_id
      - order
      - order_number
      - origin_address
      - shipping_cost
      - tracking_history
      - updated_at
      - weight
      - width
    ShipmentStatusEnum:
      enum:
      - created
      - pending
      - released
      - generated
      - posted
      - in_transit
      - out_for_delivery
      - delivered
      - cancelled
      - returned
      type: string
      description: |-
        * `created` - Pedido Criado
        * `pending` - Pendente
        * `released` - Etiqueta Paga
        * `generated` - Etiqueta Gerada
        * `posted` - Postado
        * `in_transit` - Em Trânsito
        * `out_for_delivery` - Saiu para Entrega
        * `delivered` - Entregue
        * `cancelled` - Cancelado
        * `returned` - Devolvido
    ShipmentTracking:
      type: object
      description: Serializer de rastreamento
      properties:
        id:
          type: integer
          readOnly: true
        package_me_id:
          type: string
          description: ID ME do carrinho ao qual este evento pertence (identifica
            o pacote).
          maxLength: 255
        status:
          type: string
          maxLength: 100
        description:
          type: string
        location:
          type: string
          maxLength: 255
        occurred_at:
          type: string
          format: date-time
        created_at:
          type: string
          format: date-time
          readOnly: true
      required:
      - created_at
      - description
      - id
      - occurred_at
      - status
    ShippingMethodEnum:
      enum:
      - in_person
      - melhor_envio
      - both
      type: string
      description: |-
        * `in_person` - Somente Entrega Presencial
        * `melhor_envio` - Somente Melhor Envio
        * `both` - Ambos (Presencial e Melhor Envio)
    ShippingQuote:
      type: object
      description: Serializer de cotação de frete salva
      properties:
        id:
          type: integer
          readOnly: true
        seller:
          type: integer
          nullable: true
        seller_name:
          type: string
          readOnly: true
        origin_zipcode:
          type: string
          maxLength: 9
        origin_address: {}
        destination_zipcode:
          type: string
          maxLength: 9
        destination_address: {}
        weight:
          type: string
          format: decimal
          pattern: ^-?\d{0,4}(?:\.\d{0,2})?$
        height:
          type: string
          format: decimal
          pattern: ^-?\d{0,4}(?:\.\d{0,2})?$
        width:
          type: string
          format: decimal
          pattern: ^-?\d{0,4}(?:\.\d{0,2})?$
        length:
          type: string
          format: decimal
          pattern: ^-?\d{0,4}(?:\.\d{0,2})?$
        declared_value:
          type: string
          format: decimal
          pattern: ^-?\d{0,8}(?:\.\d{0,2})?$
        services:
          type: array
          items:
            type: object
            additionalProperties: {}
          readOnly: true
        created_at:
          type: string
          format: date-time
          readOnly: true
        expires_at:
          type: string
          format: date-time
      required:
      - created_at
      - declared_value
      - destination_address
      - destination_zipcode
      - expires_at
      - height
      - id
      - length
      - origin_address
      - origin_zipcode
      - seller_name
      - services
      - weight
      - width
    SocialAccount:
      type: object
      description: |-
        Serializer for SocialAccount instances.

        Provides a REST API representation of django-allauth SocialAccount
        objects, including provider information and connection metadata.
      properties:
        id:
          type: integer
          readOnly: true
        provider:
          type: string
          title: Provedor
          maxLength: 200
        uid:
          type: string
          maxLength: 191
        last_login:
          type: string
          format: date-time
          readOnly: true
          title: Último acesso
        date_joined:
          type: string
          format: date-time
          readOnly: true
          title: Data de adesão
      required:
      - date_joined
      - id
      - last_login
      - provider
      - uid
    SocialConnect:
      type: object
      description: |-
        Serializer for connecting social accounts to existing user accounts.

        Handles OAuth authorization code exchange and connects the social
        account to the currently authenticated user's account.
      properties:
        detail:
          type: string
          readOnly: true
      required:
      - detail
    SocialConnectRequest:
      type: object
      description: |-
        Serializer for connecting social accounts to existing user accounts.

        Handles OAuth authorization code exchange and connects the social
        account to the currently authenticated user's account.
      properties:
        code:
          type: string
          writeOnly: true
          minLength: 1
      required:
      - code
    ToggleActiveResponse:
      type: object
      properties:
        is_active:
          type: boolean
      required:
      - is_active
    TokenVerifyRequest:
      type: object
      properties:
        token:
          type: string
          writeOnly: true
          minLength: 1
      required:
      - token
    TrackShipmentResponse:
      type: object
      properties:
        shipment:
          $ref: '#/components/schemas/Shipment'
        tracking_data:
          type: object
          additionalProperties: {}
        message:
          type: string
      required:
      - message
      - shipment
      - tracking_data
    UpdateMeetingResponse:
      type: object
      properties:
        message:
          type: string
        delivery:
          $ref: '#/components/schemas/InPersonDelivery'
      required:
      - delivery
      - message
    User:
      type: object
      description: User profile information and updates.
      properties:
        pk:
          type: integer
          readOnly: true
          title: ID
        email:
          type: string
          format: email
          readOnly: true
        first_name:
          type: string
          title: Primeiro nome
          maxLength: 150
        last_name:
          type: string
          title: Último nome
          maxLength: 150
      required:
      - email
      - pk
    VerifyEmail:
      type: object
      description: Email address verification with confirmation key.
      properties:
        detail:
          type: string
          readOnly: true
      required:
      - detail
    VerifyEmailRequest:
      type: object
      description: Email address verification with confirmation key.
      properties:
        key:
          type: string
          writeOnly: true
          minLength: 1
      required:
      - key
    WebhookResponse:
      type: object
      properties:
        message:
          type: string
      required:
      - message
  securitySchemes:
    JWTAuthentication:
      type: http
      scheme: bearer
      bearerFormat: JWT
    JWTCookieAuthentication:
      type: apiKey
      in: cookie
      name: auth-jwt
tags:
- name: Authentication
  description: User registration, login, profile management, and social authentication
- name: Products
  description: Product catalog, categories, brands, marketplace listings, and search
- name: Cart
  description: Shopping cart management
- name: Orders
  description: Order creation, management, and buyer operations
- name: Seller Orders
  description: Seller order management and status updates
- name: Payments
  description: Payment intent creation, confirmation, refunds, and seller payouts
- name: Stripe Connect
  description: Seller onboarding and connected account management
- name: Logistics - Addresses
  description: Address management for buyers and sellers
- name: Logistics - Shipping
  description: Shipping quotes, shipments, tracking, and label generation
- name: Logistics - Deliveries
  description: 'Order delivery orchestration (dual delivery: shipping + in-person)'
- name: Logistics - In-Person
  description: In-person delivery management, meeting scheduling, and confirmation
- name: Logistics - Utilities
  description: CEP/zipcode lookup and other utilities
