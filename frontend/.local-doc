                $ref: '#/components/schemas/OrderDeliveriesDetailsResponse'
          description: ''
        '403':
          description: No permission to view deliveries for this order
        '404':
          description: Order not found
  /api/logistics/deliveries/user/:
    get:
      operationId: logistics_deliveries_user_retrieve
