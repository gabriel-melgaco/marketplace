          type: integer
          readOnly: true
        buyer_name:
          type: string
          readOnly: true
        buyer_email:
          type: string
          format: email
          readOnly: true
        status:
          $ref: '#/components/schemas/OrderStatusEnum'
        status_display:
          type: string
          readOnly: true
        subtotal:
          type: string
          format: decimal
          pattern: ^-?\d{0,8}(?:\.\d{0,2})?$
        shipping_cost:
          type: string
          format: decimal
          pattern: ^-?\d{0,8}(?:\.\d{0,2})?$
        total:
          type: string
          format: decimal
          pattern: ^-?\d{0,8}(?:\.\d{0,2})?$
        shipping_address: {}
        shipping_services: {}
        payment_method:
          type: string
          maxLength: 20
        buyer_notes:
          type: string
        internal_notes:
          type: string
        created_at:
          type: string
          format: date-time
          readOnly: true
        updated_at:
          type: string
          format: date-time
          readOnly: true
        cancelled_at:
          type: string
          format: date-time
          readOnly: true
          nullable: true
        items:
          type: array
          items:
            $ref: '#/components/schemas/OrderItem'
          readOnly: true
        status_history:
          type: array
          items:
            $ref: '#/components/schemas/OrderStatusHistory'
          readOnly: true
      required:
      - buyer
      - buyer_email
      - buyer_name
      - cancelled_at
      - created_at
      - id
      - items
      - order_number
      - shipping_address
      - status_display
      - status_history
      - subtotal
      - total
      - updated_at
    OrderCreateRequestRequest:
      type: object
      properties:
        shipping_address_id:
          type: integer
          description: ID do endereço de entrega do comprador
        items_delivery:
          type: array
          items:
            $ref: '#/components/schemas/ItemDeliveryEntryRequest'
          description: Lista de escolhas de entrega por listing (um entry por item
            do carrinho). Todos os listings do carrinho devem estar presentes.
        in_person_by_seller:
          type: object
          additionalProperties: {}
          description: 'Detalhes do encontro presencial por seller_id (chave como
            string). Todos os campos são opcionais: meeting_location_name, meeting_address
            (street, number, city, state, zipcode), seller_contact_phone, buyer_contact_phone,
            scheduled_date (YYYY-MM-DD), scheduled_time (HH:MM), meeting_notes. Pode
            omitir vendedores ou enviar sub-objeto vazio {}.'
        payment_method:
          allOf:
          - $ref: '#/components/schemas/PaymentMethod1baEnum'
          description: |-
            Método de pagamento

            * `credit_card` - credit_card
            * `debit_card` - debit_card
            * `pix` - pix
            * `boleto` - boleto
        buyer_notes:
          type: string
          description: Observações do comprador (opcional)
      required:
      - items_delivery
      - payment_method
      - shipping_address_id
    OrderDeliveriesDetailsResponse:
      type: object
      properties:
        order_id:
          type: string
          format: uuid
        order_number:
          type: string
        total_delivery_cost:
          type: number
          format: double
        deliveries_by_seller:
          type: object
          additionalProperties: {}
      required:
      - deliveries_by_seller
      - order_id
      - order_number
      - total_delivery_cost
    OrderDelivery:
      type: object
      description: Serializer completo para entrega do pedido
      properties:
        id:
          type: integer
          readOnly: true
        order:
          type: string
          format: uuid
        seller:
          type: integer
        seller_name:
          type: string
          readOnly: true
        delivery_method:
          $ref: '#/components/schemas/OrderDeliveryDeliveryMethodEnum'
        status:
          $ref: '#/components/schemas/DeliveryStatusEnum'
        delivery_cost:
          type: string
          format: decimal
          pattern: ^-?\d{0,8}(?:\.\d{0,2})?$
        shipment_details:
          type: array
          items:
            $ref: '#/components/schemas/Shipment'
          readOnly: true
        in_person_delivery:
          type: integer
          nullable: true
        in_person_details:
          allOf:
          - $ref: '#/components/schemas/InPersonDelivery'
          readOnly: true
        delivery_info:
          type: object
          additionalProperties: {}
          readOnly: true
        created_at:
          type: string
          format: date-time
          readOnly: true
        updated_at:
          type: string
          format: date-time
          readOnly: true
        confirmed_at:
          type: string
          format: date-time
          nullable: true
        completed_at:
          type: string
          format: date-time
          nullable: true
      required:
      - created_at
      - delivery_info
      - id
      - in_person_details
      - order
      - seller
      - seller_name
      - shipment_details
      - updated_at
    OrderDeliveryDeliveryMethodEnum:
      enum:
      - shipping
      - in_person
      - split
      type: string
      description: |-
        * `shipping` - Envio via Transportadora
        * `in_person` - Frete por conta do Vendedor
        * `split` - Entrega Mista (Transportadora + Presencial)
    OrderItem:
      type: object
      description: Serializer de item do pedido
      properties:
        id:
          type: integer
          readOnly: true
        listing:
          type: integer
        seller:
          type: integer
        seller_name:
          type: string
          readOnly: true
        product_name:
          type: string
          maxLength: 200
        product_code:
          type: string
          maxLength: 100
        brand_name:
          type: string
          maxLength: 150
        condition_name:
          type: string
          maxLength: 100
        quantity:
          type: integer
          maximum: 2147483647
          minimum: 1
        unit_price:
          type: string
          format: decimal
          pattern: ^-?\d{0,8}(?:\.\d{0,2})?$
        subtotal:
          type: string
          format: decimal
          pattern: ^-?\d{0,8}(?:\.\d{0,2})?$
          readOnly: true
        shipping_cost:
          type: string
          format: decimal
          pattern: ^-?\d{0,8}(?:\.\d{0,2})?$
        weight_kg:
          type: string
          format: decimal
          pattern: ^-?\d{0,4}(?:\.\d{0,2})?$
        height_cm:
          type: string
          format: decimal
          pattern: ^-?\d{0,4}(?:\.\d{0,2})?$
        width_cm:
          type: string
          format: decimal
          pattern: ^-?\d{0,4}(?:\.\d{0,2})?$
        length_cm:
          type: string
          format: decimal
          pattern: ^-?\d{0,4}(?:\.\d{0,2})?$
        seller_address:
          nullable: true
      required:
      - brand_name
      - condition_name
      - height_cm
      - id
      - length_cm
      - listing
      - product_name
      - quantity
      - seller
      - seller_name
      - subtotal
      - unit_price
      - weight_kg
      - width_cm
    OrderList:
      type: object
      description: Serializer simplificado para listagem de pedidos
      properties:
        id:
          type: string
          format: uuid
          readOnly: true
        order_number:
          type: string
          readOnly: true
        buyer_name:
          type: string
          readOnly: true
        status:
          $ref: '#/components/schemas/OrderStatusEnum'
        status_display:
          type: string
          readOnly: true
        total:
          type: string
          format: decimal
          pattern: ^-?\d{0,8}(?:\.\d{0,2})?$
        items_count:
          type: integer
          readOnly: true
        created_at:
          type: string
          format: date-time
          readOnly: true
      required:
      - buyer_name
      - created_at
      - id
      - items_count
      - order_number
      - status_display
      - total
    OrderShipmentsResponse:
      type: object
      properties:
        order_id:
          type: string
          format: uuid
        order_number:
          type: string
        shipments:
          type: array
          items:
            $ref: '#/components/schemas/Shipment'
        shipments_count:
          type: integer
      required:
      - order_id
      - order_number
      - shipments
      - shipments_count
    OrderStatusEnum:
      enum:
      - pending_payment
      - paid
      - processing
      - shipped
      - delivered
      - cancelled
      - failed
      - refunded
      type: string
      description: |-
        * `pending_payment` - Aguardando Pagamento
        * `paid` - Pagamento Confirmado
        * `processing` - Aguardando Envio
        * `shipped` - Enviado
        * `delivered` - Entregue
        * `cancelled` - Cancelado
        * `failed` - Falha no Pagamento
        * `refunded` - Reembolsado
    OrderStatusHistory:
      type: object
      description: Serializer de histórico de status
      properties:
        id:
          type: integer
          readOnly: true
        old_status:
          type: string
          maxLength: 20
        new_status:
          type: string
          maxLength: 20
        changed_by:
          type: integer
          nullable: true
        changed_by_name:
          type: string
          readOnly: true
        notes:
          type: string
        created_at:
          type: string
          format: date-time
          readOnly: true
      required:
      - changed_by_name
      - created_at
      - id
      - new_status
    OrderUpdateStatusRequest:
      type: object
      description: Serializer para atualizar status do pedido
      properties:
        status:
          $ref: '#/components/schemas/OrderStatusEnum'
        notes:
          type: string
      required:
      - status
    PaginatedAddressList:
      type: object
