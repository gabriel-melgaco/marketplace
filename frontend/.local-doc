          maxLength: 150
        price:
          type: string
          format: decimal
          pattern: ^-?\d{0,8}(?:\.\d{0,2})?$
        shipping_method:
          allOf:
          - $ref: '#/components/schemas/ShippingMethodEnum'
          description: |-
            Método de envio aceito pelo vendedor para este anúncio. 'in_person' = somente entrega presencial; 'melhor_envio' = somente via transportadora; 'both' = ambos os métodos são aceitos.

            * `in_person` - Somente Entrega Presencial
            * `melhor_envio` - Somente Melhor Envio
            * `both` - Ambos (Presencial e Melhor Envio)
        quantity:
          type: integer
          maximum: 2147483647
          minimum: 0
        is_active:
          type: boolean
        description:
          type: string
          maxLength: 255
        views_count:
          type: integer
          maximum: 2147483647
          minimum: 0
        weight_kg:
          type: string
          format: decimal
          pattern: ^-?\d{0,4}(?:\.\d{0,2})?$
          nullable: true
          description: Peso em kg (legado — use packages)
        height_cm:
          type: string
          format: decimal
          pattern: ^-?\d{0,4}(?:\.\d{0,2})?$
          nullable: true
          description: Altura em cm (legado — use packages)
        width_cm:
          type: string
          format: decimal
          pattern: ^-?\d{0,4}(?:\.\d{0,2})?$
          nullable: true
          description: Largura em cm (legado — use packages)
        length_cm:
          type: string
          format: decimal
          pattern: ^-?\d{0,4}(?:\.\d{0,2})?$
          nullable: true
          description: Comprimento em cm (legado — use packages)
        created_at:
          type: string
          format: date-time
          readOnly: true
        updated_at:
          type: string
          format: date-time
          readOnly: true
        sold_at:
          type: string
          format: date-time
          nullable: true
        seller:
          type: integer
      required:
      - brand
      - condition
      - created_at
      - description
      - id
      - images
      - packages
      - price
      - product
      - seller
      - seller_email
      - seller_name
      - shipping_address
      - title
      - updated_at
    MarketplaceListingImage:
