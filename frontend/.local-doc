          multipart/form-data:
            schema:
              $ref: '#/components/schemas/PresignedUrlRequest'
        required: true
      security:
      - JWTAuthentication: []
        JWTCookieAuthentication: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/PresignedUrlResponse'
          description: ''
        '401':
          description: Não autenticado
components:
  schemas:
    AccountStatusResponse:
      type: object
      properties:
        has_account:
          type: boolean
        ready_to_receive_payments:
          type: boolean
        onboarding_complete:
          type: boolean
        requirements_status:
          type: string
          nullable: true
      required:
      - has_account
      - onboarding_complete
      - ready_to_receive_payments
    Address:
      type: object
      description: Serializer completo de endereço
      properties:
        id:
          type: integer
          readOnly: true
        address_type:
          $ref: '#/components/schemas/AddressTypeEnum'
        nickname:
          type: string
          maxLength: 50
        recipient_name:
          type: string
          maxLength: 200
        recipient_phone:
          type: string
          maxLength: 20
        zipcode:
          type: string
          maxLength: 9
        street:
          type: string
          maxLength: 200
        number:
          type: string
          maxLength: 20
        complement:
          type: string
          maxLength: 100
        neighborhood:
          type: string
          maxLength: 100
        city:
          type: string
          maxLength: 100
        state:
          type: string
          maxLength: 2
        country:
          type: string
          maxLength: 2
        is_default:
          type: boolean
        is_active:
          type: boolean
        is_shipping_address:
          type: boolean
        created_at:
          type: string
          format: date-time
          readOnly: true
        updated_at:
          type: string
          format: date-time
          readOnly: true
      required:
      - city
      - created_at
      - id
      - neighborhood
      - number
      - recipient_name
      - recipient_phone
      - state
      - street
      - updated_at
      - zipcode
    AddressCreate:
      type: object
      description: Serializer para criar endereço
      properties:
        address_type:
          $ref: '#/components/schemas/AddressTypeEnum'
        nickname:
          type: string
          maxLength: 50
        recipient_name:
          type: string
          maxLength: 200
        recipient_phone:
          type: string
          maxLength: 20
        zipcode:
          type: string
          maxLength: 9
        street:
          type: string
          maxLength: 200
        number:
          type: string
          maxLength: 20
        complement:
          type: string
          maxLength: 100
        neighborhood:
          type: string
          maxLength: 100
        city:
          type: string
          maxLength: 100
        state:
          type: string
          maxLength: 2
        is_default:
          type: boolean
        is_shipping_address:
          type: boolean
      required:
      - city
      - neighborhood
      - number
      - recipient_name
      - recipient_phone
      - state
      - street
      - zipcode
    AddressCreateRequest:
      type: object
      description: Serializer para criar endereço
      properties:
        address_type:
          $ref: '#/components/schemas/AddressTypeEnum'
        nickname:
          type: string
          maxLength: 50
        recipient_name:
          type: string
          minLength: 1
          maxLength: 200
        recipient_phone:
          type: string
          minLength: 1
          maxLength: 20
        zipcode:
          type: string
          minLength: 1
          maxLength: 9
        street:
          type: string
          minLength: 1
          maxLength: 200
        number:
          type: string
          minLength: 1
          maxLength: 20
        complement:
          type: string
          maxLength: 100
        neighborhood:
          type: string
          minLength: 1
          maxLength: 100
        city:
          type: string
          minLength: 1
          maxLength: 100
        state:
          type: string
          minLength: 1
          maxLength: 2
        is_default:
          type: boolean
        is_shipping_address:
          type: boolean
      required:
      - city
      - neighborhood
      - number
      - recipient_name
      - recipient_phone
      - state
      - street
      - zipcode
    AddressTypeEnum:
      enum:
      - home
      - work
      - shipping
      - other
      type: string
      description: |-
        * `home` - Residencial
        * `work` - Comercial
        * `shipping` - Envio (Vendedor)
        * `other` - Outro
    Brand:
      type: object
      description: Serializer completo de marca
      properties:
        id:
          type: integer
          readOnly: true
        name:
          type: string
          maxLength: 150
        slug:
          type: string
          maxLength: 50
          pattern: ^[-a-zA-Z0-9_]+$
        logo:
          type: string
          nullable: true
          maxLength: 255
        website:
          type: string
          format: uri
          maxLength: 200
        is_active:
          type: boolean
      required:
      - id
      - name
      - slug
    BrandSimple:
      type: object
      description: Serializer simples de marca
      properties:
        id:
          type: integer
          readOnly: true
        name:
          type: string
          maxLength: 150
        slug:
          type: string
          maxLength: 50
          pattern: ^[-a-zA-Z0-9_]+$
        logo:
          type: string
          nullable: true
          maxLength: 255
      required:
      - id
      - name
      - slug
    CEPLookupRequest:
      type: object
      description: Serializer para buscar endereço por CEP
      properties:
        zipcode:
          type: string
          minLength: 1
          maxLength: 9
      required:
      - zipcode
    CEPLookupResponse:
      type: object
      properties:
        zipcode:
          type: string
        street:
          type: string
        neighborhood:
          type: string
        city:
          type: string
        state:
          type: string
      required:
      - city
      - neighborhood
      - state
      - street
      - zipcode
    CalculateShippingRequestRequest:
      type: object
      properties:
        shipping_address_id:
          type: integer
          description: ID of the saved shipping address
      required:
      - shipping_address_id
    CalculateShippingResponse:
      type: object
      properties:
        quotes_by_seller:
          allOf:
          - $ref: '#/components/schemas/SellerQuoteMap'
          description: Cotações agrupadas por seller_id
        shipping_address:
          $ref: '#/components/schemas/Address'
        shipping_address_id:
          type: integer
        total_items:
          type: integer
        total_value:
          type: number
          format: double
      required:
      - quotes_by_seller
      - shipping_address
      - shipping_address_id
      - total_items
      - total_value
    CancelInPersonDeliveryRequestRequest:
      type: object
      properties:
        cancellation_reason:
          type: string
          minLength: 1
          description: Optional cancellation reason
    CancelInPersonDeliveryResponse:
      type: object
      properties:
        message:
          type: string
        delivery:
          $ref: '#/components/schemas/InPersonDelivery'
      required:
      - delivery
      - message
    CarrierServicesResponse:
      type: object
      properties:
        services:
          type: array
          items:
            type: object
            additionalProperties: {}
          description: List of available shipping services from Melhor Envio
        count:
          type: integer
          description: Total number of services returned
      required:
      - count
      - services
    Cart:
      type: object
      description: Serializer do carrinho
      properties:
        id:
          type: integer
          readOnly: true
        items:
          type: array
          items:
            $ref: '#/components/schemas/CartItem'
          readOnly: true
        total:
          type: string
          format: decimal
          pattern: ^-?\d{0,8}(?:\.\d{0,2})?$
          readOnly: true
        items_count:
          type: integer
          readOnly: true
        sellers:
          type: array
          items:
            type: integer
          readOnly: true
        created_at:
          type: string
          format: date-time
          readOnly: true
        updated_at:
          type: string
          format: date-time
          readOnly: true
      required:
      - created_at
      - id
      - items
      - items_count
      - sellers
      - total
      - updated_at
    CartItem:
      type: object
      description: Serializer de item do carrinho
      properties:
        id:
          type: integer
          readOnly: true
        listing:
          allOf:
          - $ref: '#/components/schemas/MarketplaceListing'
          readOnly: true
        quantity:
          type: integer
          maximum: 2147483647
          minimum: 1
        subtotal:
          type: string
          format: decimal
          pattern: ^-?\d{0,8}(?:\.\d{0,2})?$
          readOnly: true
        seller_id:
          type: integer
          readOnly: true
        seller_name:
          type: string
          readOnly: true
        added_at:
          type: string
          format: date-time
          readOnly: true
      required:
      - added_at
      - id
      - listing
      - seller_id
      - seller_name
      - subtotal
    CartItemCreateRequest:
      type: object
      description: Serializer para adicionar item ao carrinho
      properties:
        listing:
          type: integer
        quantity:
          type: integer
          maximum: 2147483647
          minimum: 1
      required:
      - listing
    Category:
      type: object
      description: Serializer completo de categoria com hierarquia
      properties:
        id:
          type: integer
          readOnly: true
        name:
          type: string
          maxLength: 100
        slug:
          type: string
          maxLength: 50
          pattern: ^[-a-zA-Z0-9_]+$
        parent:
          type: string
          readOnly: true
        children:
          type: array
          items:
            $ref: '#/components/schemas/CategoryChildren'
          readOnly: true
        is_active:
          type: boolean
      required:
      - children
      - id
      - name
      - parent
      - slug
    CategoryChildren:
      type: object
      description: Serializer para subcategorias
      properties:
        id:
          type: integer
          readOnly: true
        name:
          type: string
          maxLength: 100
        slug:
          type: string
          maxLength: 50
          pattern: ^[-a-zA-Z0-9_]+$
      required:
      - id
      - name
      - slug
    CategorySimple:
      type: object
      description: Serializer simples de categoria
      properties:
        id:
          type: integer
          readOnly: true
        name:
          type: string
          maxLength: 100
        slug:
          type: string
          maxLength: 50
          pattern: ^[-a-zA-Z0-9_]+$
      required:
      - id
      - name
      - slug
    CompleteInPersonDeliveryRequestRequest:
      type: object
      properties:
        completion_notes:
          type: string
          minLength: 1
          description: Optional completion notes
    CompleteInPersonDeliveryResponse:
      type: object
      properties:
        message:
          type: string
        delivery:
          $ref: '#/components/schemas/InPersonDelivery'
      required:
      - delivery
      - message
    Condition:
      type: object
      description: Serializer de condição
      properties:
        id:
          type: integer
          readOnly: true
        name:
          type: string
          maxLength: 100
        slug:
          type: string
          maxLength: 50
          pattern: ^[-a-zA-Z0-9_]+$
      required:
      - id
      - name
      - slug
    ConfirmMeetingResponse:
      type: object
      properties:
        message:
          type: string
        delivery:
          $ref: '#/components/schemas/InPersonDelivery'
      required:
      - delivery
      - message
    CookieTokenRefresh:
      type: object
      description: JWT token refresh with cookie and request data support.
      properties:
        access:
          type: string
          readOnly: true
        access_expiration:
          type: string
          format: date-time
          readOnly: true
      required:
      - access
      - access_expiration
    CookieTokenRefreshRequest:
      type: object
      description: JWT token refresh with cookie and request data support.
      properties:
        refresh:
          type: string
          writeOnly: true
          description: Will override cookie.
    CreateCheckoutWithConnectRequestRequest:
      type: object
      properties:
        order_id:
          type: string
          format: uuid
          description: Order UUID
      required:
      - order_id
    CreateCheckoutWithConnectResponse:
      type: object
      properties:
        checkout_url:
          type: string
          format: uri
        session_id:
          type: string
        platform_fee:
          type: number
          format: double
      required:
      - checkout_url
      - platform_fee
      - session_id
    CreateConnectedAccountResponse:
      type: object
      properties:
        account_id:
          type: string
        message:
          type: string
      required:
      - account_id
      - message
    CreateOrderDeliveriesRequestRequest:
      type: object
      properties:
        order_id:
          type: string
          format: uuid
          description: Order UUID
      required:
      - order_id
    CreateOrderDeliveriesResponse:
      type: object
      properties:
        order_id:
          type: string
          format: uuid
        order_number:
          type: string
        deliveries:
          type: array
          items:
            $ref: '#/components/schemas/OrderDelivery'
        count:
          type: integer
      required:
      - count
      - deliveries
      - order_id
      - order_number
    CreateShipmentsRequestRequest:
      type: object
      properties:
        order_id:
          type: string
          format: uuid
          description: Order UUID
      required:
      - order_id
    CreateShipmentsResponse:
      type: object
      properties:
        shipments:
          type: array
          items:
            $ref: '#/components/schemas/Shipment'
        created_count:
          type: integer
        order_status:
          type: string
        checkout_result:
          type: object
          additionalProperties: {}
          description: Raw checkout response from Melhor Envio API
      required:
      - created_count
      - order_status
      - shipments
    CustomRegister:
      type: object
      description: |-
        Valida CPF/CNPJ:
        - formato
        - dígitos verificadores
        - unicidade
        - suporta create e update
      properties:
        detail:
          type: string
          readOnly: true
        full_name:
          type: string
        cpf:
          type: string
        birthday:
          type: string
          format: date
        picture:
          type: string
          nullable: true
      required:
      - birthday
      - cpf
      - detail
      - full_name
    CustomRegisterRequest:
      type: object
      description: |-
        Valida CPF/CNPJ:
        - formato
        - dígitos verificadores
        - unicidade
        - suporta create e update
      properties:
        email:
          type: string
          format: email
          writeOnly: true
          minLength: 1
        password1:
          type: string
          writeOnly: true
          minLength: 1
        password2:
          type: string
          writeOnly: true
          minLength: 1
        full_name:
          type: string
          minLength: 1
        cpf:
          type: string
          minLength: 1
        birthday:
          type: string
          format: date
        picture:
          type: string
          nullable: true
      required:
      - birthday
      - cpf
      - email
      - full_name
      - password1
      - password2
    CustomUser:
      type: object
      description: |-
        Valida CPF/CNPJ:
        - formato
        - dígitos verificadores
        - unicidade
        - suporta create e update
      properties:
        id:
          type: integer
          readOnly: true
        email:
          type: string
          format: email
          maxLength: 254
        full_name:
          type: string
          maxLength: 50
        birthday:
          type: string
          format: date
          nullable: true
        cpf:
          type: string
          nullable: true
          maxLength: 14
        picture:
          type: string
          nullable: true
          maxLength: 255
        is_active:
          type: boolean
          title: Ativo
          description: Indica que o usuário será tratado como ativo. Ao invés de excluir
            contas de usuário, desmarque isso.
      required:
      - email
      - full_name
      - id
    CustomUserRequest:
      type: object
      description: |-
        Valida CPF/CNPJ:
        - formato
        - dígitos verificadores
        - unicidade
        - suporta create e update
      properties:
        email:
          type: string
          format: email
          minLength: 1
          maxLength: 254
        full_name:
          type: string
          minLength: 1
          maxLength: 50
        birthday:
          type: string
          format: date
          nullable: true
        cpf:
          type: string
          nullable: true
          maxLength: 14
        picture:
          type: string
          nullable: true
          maxLength: 255
        is_active:
          type: boolean
          title: Ativo
          description: Indica que o usuário será tratado como ativo. Ao invés de excluir
            contas de usuário, desmarque isso.
      required:
      - email
      - full_name
    DeliveryStatusEnum:
      enum:
      - pending
      - confirmed
      - ready
      - in_transit
      - delivered
      - cancelled
      - failed
      type: string
      description: |-
        * `pending` - Pendente
        * `confirmed` - Confirmado
        * `ready` - Pronto para Retirada/Envio
        * `in_transit` - Em Trânsito
        * `delivered` - Entregue/Retirado
        * `cancelled` - Cancelado
        * `failed` - Falhou
    FilterOptionsResponse:
      type: object
      properties:
        categories:
          type: array
          items:
            $ref: '#/components/schemas/Category'
        brands:
          type: array
          items:
            $ref: '#/components/schemas/Brand'
        conditions:
          type: array
          items:
            $ref: '#/components/schemas/Condition'
        price_range:
          type: object
          additionalProperties: {}
      required:
      - brands
      - categories
      - conditions
      - price_range
    GenerateLabelResponse:
      type: object
      properties:
        label_url:
          type: string
          format: uri
        shipment_id:
          type: integer
        message:
          type: string
      required:
      - label_url
      - message
      - shipment_id
    GoogleSocialLogin:
      type: object
      description: Social authentication with Google OAuth credentials response.
      properties:
        access:
          type: string
          readOnly: true
        refresh:
          type: string
          readOnly: true
        access_expiration:
          type: string
          format: date-time
          readOnly: true
        refresh_expiration:
          type: string
          format: date-time
          readOnly: true
        user:
          allOf:
          - $ref: '#/components/schemas/User'
          readOnly: true
      required:
      - access
      - access_expiration
      - refresh
      - refresh_expiration
      - user
    GoogleSocialLoginRequest:
      type: object
      description: Social authentication with Google OAuth credentials response.
      properties:
        code:
          type: string
          writeOnly: true
          minLength: 1
      required:
      - code
    InPersonDelivery:
      type: object
      description: Serializer completo para entrega presencial
      properties:
        id:
          type: integer
          readOnly: true
        seller:
          type: integer
          readOnly: true
        seller_name:
          type: string
          readOnly: true
        buyer:
          type: integer
          readOnly: true
        buyer_name:
          type: string
          readOnly: true
        meeting_status:
          $ref: '#/components/schemas/MeetingStatusEnum'
        meeting_location_name:
          type: string
          description: 'Nome do local (ex: Shopping X, Estação Y)'
          maxLength: 200
        meeting_address:
          description: Endereço completo do local de encontro
        meeting_notes:
          type: string
          description: 'Observações sobre o local (ex: próximo à entrada principal)'
        scheduled_date:
          type: string
          format: date
          nullable: true
          description: Data agendada para o encontro
        scheduled_time:
          type: string
          format: time
          nullable: true
          description: Horário agendado para o encontro
        seller_contact_phone:
          type: string
          description: Telefone do vendedor para contato
          maxLength: 20
        buyer_contact_phone:
          type: string
          description: Telefone do comprador para contato
          maxLength: 20
        seller_confirmed:
          type: boolean
        buyer_confirmed:
          type: boolean
        seller_confirmed_at:
          type: string
          format: date-time
          readOnly: true
          nullable: true
        buyer_confirmed_at:
          type: string
          format: date-time
          readOnly: true
          nullable: true
        is_fully_confirmed:
          type: boolean
          readOnly: true
        seller_completed:
          type: boolean
        buyer_completed:
          type: boolean
        seller_completed_at:
          type: string
          format: date-time
          readOnly: true
          nullable: true
        buyer_completed_at:
          type: string
          format: date-time
          readOnly: true
          nullable: true
        is_fully_completed:
          type: boolean
          readOnly: true
        completion_notes:
          type: string
          description: Observações sobre a conclusão da entrega
        created_at:
          type: string
          format: date-time
          readOnly: true
        updated_at:
          type: string
          format: date-time
          readOnly: true
        completed_at:
          type: string
          format: date-time
          readOnly: true
          nullable: true
      required:
      - buyer
      - buyer_completed_at
      - buyer_confirmed_at
      - buyer_name
      - completed_at
      - created_at
      - id
      - is_fully_completed
      - is_fully_confirmed
      - seller
      - seller_completed_at
      - seller_confirmed_at
      - seller_name
      - updated_at
    InPersonItem:
      type: object
      properties:
        listing_id:
          type: integer
        title:
          type: string
        shipping_method:
          type: string
      required:
      - listing_id
      - shipping_method
      - title
    IncrementViewResponse:
      type: object
      properties:
        views_count:
          type: integer
      required:
      - views_count
    ItemDeliveryEntryDeliveryMethodEnum:
      enum:
      - melhor_envio
      - in_person
      type: string
      description: |-
        * `melhor_envio` - melhor_envio
        * `in_person` - in_person
    ItemDeliveryEntryRequest:
      type: object
      properties:
        listing_id:
          type: integer
          description: ID do listing do carrinho
        delivery_method:
          allOf:
          - $ref: '#/components/schemas/ItemDeliveryEntryDeliveryMethodEnum'
          description: |-
            Método de entrega para este item. 'melhor_envio' requer service_id. Deve respeitar listing.shipping_method: in_person-only → obrigado 'in_person'; melhor_envio-only → obrigatório 'melhor_envio'; both → qualquer um.

            * `melhor_envio` - melhor_envio
            * `in_person` - in_person
        service_id:
          type: integer
          description: ID do serviço de frete (obrigatório quando delivery_method='melhor_envio')
      required:
      - delivery_method
      - listing_id
    JWTLogout:
      type: object
      description: JWT logout with refresh token blacklisting.
      properties:
        detail:
          type: string
          readOnly: true
      required:
      - detail
    JWTLogoutRequest:
      type: object
      description: JWT logout with refresh token blacklisting.
      properties:
        refresh:
          type: string
          writeOnly: true
          minLength: 1
    ListInPersonDeliveriesResponse:
      type: object
      properties:
        deliveries:
          type: array
          items:
            $ref: '#/components/schemas/InPersonDelivery'
        count:
          type: integer
      required:
      - count
      - deliveries
    ListUserDeliveriesResponse:
      type: object
      properties:
        deliveries:
          type: array
          items:
            $ref: '#/components/schemas/OrderDelivery'
        count:
          type: integer
      required:
      - count
      - deliveries
    ListingFreightOption:
      type: object
      description: |-
        Representa uma única opção de frete retornada para o listing.

        Ordenadas por preço crescente na resposta.
      properties:
        service_id:
          type: integer
          description: ID do serviço no Melhor Envio
        name:
          type: string
          description: 'Nome do serviço (ex: ''PAC'', ''SEDEX'')'
        company:
          type: string
          description: 'Nome da transportadora (ex: ''Correios'')'
        company_picture:
          type: string
          format: uri
          description: URL do logotipo da transportadora
        price:
          type: string
          format: decimal
          pattern: ^-?\d{0,8}(?:\.\d{0,2})?$
          description: Preço total do frete em R$ (soma de todos os packages)
        delivery_days:
          type: integer
          description: Prazo de entrega em dias úteis
      required:
      - company
      - company_picture
      - delivery_days
      - name
      - price
      - service_id
    ListingFreightQuoteRequestRequest:
      type: object
      description: |-
        Payload de entrada para calcular frete de um listing específico.

        Utilizado pelo endpoint POST /api/logistics/listings/<listing_id>/freight-quote/
      properties:
        destination_cep:
          type: string
          minLength: 1
          description: 'CEP de destino do comprador (ex: ''01310-100'' ou ''01310100'')'
          maxLength: 9
      required:
      - destination_cep
    ListingFreightQuoteResponse:
      type: object
      description: |-
        Resposta do cálculo de frete para um listing.

        Quando available=True, a chave 'options' está presente com as opções disponíveis
        ordenadas pelo menor preço.

        Quando available=False, a chave 'message' explica o motivo da indisponibilidade.
      properties:
        available:
          type: boolean
          description: True se há opções de frete disponíveis para este anúncio.
        options:
          type: array
          items:
            $ref: '#/components/schemas/ListingFreightOption'
          description: Lista de opções de frete (presente somente quando available=True)
        message:
          type: string
          description: Mensagem explicativa (presente somente quando available=False)
      required:
      - available
    ListingPackage:
      type: object
      description: |-
        Serializer para pacotes de um anúncio (ListingPackage).

        Valida que todas as dimensões e peso são maiores que zero.
        Usado como nested serializer em criação/atualização de listings
        e como serializer standalone nos endpoints /packages/.
      properties:
        id:
          type: integer
          readOnly: true
        weight_kg:
          type: string
          format: decimal
          pattern: ^-?\d{0,4}(?:\.\d{0,2})?$
          description: Peso do pacote em kg
        height_cm:
          type: string
          format: decimal
          pattern: ^-?\d{0,4}(?:\.\d{0,2})?$
          description: Altura do pacote em cm
        width_cm:
          type: string
          format: decimal
          pattern: ^-?\d{0,4}(?:\.\d{0,2})?$
          description: Largura do pacote em cm
        length_cm:
          type: string
          format: decimal
          pattern: ^-?\d{0,4}(?:\.\d{0,2})?$
          description: Comprimento do pacote em cm
        description:
          type: string
          description: 'Descrição opcional do pacote (ex: ''Caixa grande'')'
          maxLength: 100
      required:
      - height_cm
      - id
      - length_cm
      - weight_kg
      - width_cm
    ListingPackageRequest:
      type: object
      description: |-
        Serializer para pacotes de um anúncio (ListingPackage).

        Valida que todas as dimensões e peso são maiores que zero.
        Usado como nested serializer em criação/atualização de listings
        e como serializer standalone nos endpoints /packages/.
      properties:
        weight_kg:
          type: string
          format: decimal
          pattern: ^-?\d{0,4}(?:\.\d{0,2})?$
          description: Peso do pacote em kg
        height_cm:
          type: string
          format: decimal
          pattern: ^-?\d{0,4}(?:\.\d{0,2})?$
          description: Altura do pacote em cm
        width_cm:
          type: string
          format: decimal
          pattern: ^-?\d{0,4}(?:\.\d{0,2})?$
          description: Largura do pacote em cm
        length_cm:
          type: string
          format: decimal
          pattern: ^-?\d{0,4}(?:\.\d{0,2})?$
          description: Comprimento do pacote em cm
        description:
          type: string
          description: 'Descrição opcional do pacote (ex: ''Caixa grande'')'
          maxLength: 100
      required:
      - height_cm
      - length_cm
      - weight_kg
      - width_cm
    LoginRequest:
      type: object
      description: User authentication with credentials response.
      properties:
        email:
          type: string
          format: email
          writeOnly: true
          minLength: 1
        password:
          type: string
          writeOnly: true
          minLength: 1
      required:
      - email
      - password
    LoginResponse:
      type: object
      properties:
        access:
          type: string
        refresh:
          type: string
        access_expiration:
          type: string
          format: date-time
        refresh_expiration:
          type: string
          format: date-time
        user:
          $ref: '#/components/schemas/LoginUserResponse'
      required:
      - access
      - access_expiration
      - refresh
      - refresh_expiration
      - user
    LoginUserResponse:
      type: object
      properties:
        id:
          type: integer
        email:
          type: string
          format: email
        full_name:
          type: string
        birthday:
          type: string
          format: date
        cpf:
          type: string
        picture:
          type: string
        is_active:
          type: boolean
      required:
      - birthday
      - cpf
      - email
      - full_name
      - id
      - is_active
      - picture
    MEAccountInfoResponse:
      type: object
      properties:
        firstname:
          type: string
        lastname:
          type: string
        email:
          type: string
        document:
          type: string
        phone:
          type: string
        company_name:
          type: string
          nullable: true
      required:
      - company_name
      - document
      - email
      - firstname
      - lastname
      - phone
    MarkAsSoldResponse:
      type: object
      properties:
        message:
          type: string
      required:
      - message
    MarkShipmentShippedRequestRequest:
      type: object
      properties:
        tracking_code:
          type: string
          minLength: 1
          description: Tracking code provided by the carrier
      required:
      - tracking_code
    MarkShipmentShippedResponse:
      type: object
      properties:
        message:
          type: string
        shipment:
          $ref: '#/components/schemas/Shipment'
        order_status:
          type: string
        order_transitioned:
          type: boolean
      required:
      - message
      - order_status
      - order_transitioned
      - shipment
    MarketplaceListing:
      type: object
      description: Serializer completo de listagem para listagem
      properties:
        id:
          type: integer
          readOnly: true
        product:
          allOf:
          - $ref: '#/components/schemas/ProductSimple'
          readOnly: true
        seller:
          type: integer
          readOnly: true
        seller_name:
          type: string
          readOnly: true
        title:
          type: string
          description: Título do anúncio
          maxLength: 150
        price:
          type: string
          format: decimal
          pattern: ^-?\d{0,8}(?:\.\d{0,2})?$
        brand:
          allOf:
          - $ref: '#/components/schemas/BrandSimple'
          readOnly: true
        quantity:
          type: integer
          maximum: 2147483647
          minimum: 0
        is_active:
          type: boolean
        description:
          type: string
          maxLength: 255
        condition:
          allOf:
          - $ref: '#/components/schemas/Condition'
          readOnly: true
        views_count:
          type: integer
          readOnly: true
        weight_kg:
          type: string
          format: decimal
          pattern: ^-?\d{0,4}(?:\.\d{0,2})?$
          nullable: true
          description: Peso em kg (legado — use packages)
        height_cm:
          type: string
          format: decimal
          pattern: ^-?\d{0,4}(?:\.\d{0,2})?$
          nullable: true
          description: Altura em cm (legado — use packages)
        width_cm:
          type: string
          format: decimal
          pattern: ^-?\d{0,4}(?:\.\d{0,2})?$
          nullable: true
          description: Largura em cm (legado — use packages)
        length_cm:
          type: string
          format: decimal
          pattern: ^-?\d{0,4}(?:\.\d{0,2})?$
          nullable: true
          description: Comprimento em cm (legado — use packages)
        shipping_method:
          allOf:
          - $ref: '#/components/schemas/ShippingMethodEnum'
          description: |-
            Método de envio aceito pelo vendedor para este anúncio. 'in_person' = somente entrega presencial; 'melhor_envio' = somente via transportadora; 'both' = ambos os métodos são aceitos.

            * `in_person` - Somente Entrega Presencial
            * `melhor_envio` - Somente Melhor Envio
            * `both` - Ambos (Presencial e Melhor Envio)
        created_at:
          type: string
          format: date-time
          readOnly: true
        updated_at:
          type: string
          format: date-time
          readOnly: true
        sold_at:
          type: string
          format: date-time
          readOnly: true
          nullable: true
        images:
          type: array
          items:
            $ref: '#/components/schemas/MarketplaceListingImage'
          readOnly: true
        primary_image:
          type: string
          format: uri
          nullable: true
          readOnly: true
        packages:
          type: array
          items:
            $ref: '#/components/schemas/ListingPackage'
          readOnly: true
        shipping_address:
          allOf:
          - $ref: '#/components/schemas/Address'
          readOnly: true
      required:
      - brand
      - condition
      - created_at
      - description
      - id
      - images
      - packages
      - price
      - primary_image
      - product
      - seller
      - seller_name
      - shipping_address
      - sold_at
      - title
      - updated_at
      - views_count
    MarketplaceListingCreate:
      type: object
      description: |-
        Serializer para criar listagem.

        O campo `packages` é obrigatório e deve conter pelo menos 1 pacote com
        as dimensões físicas do produto. Os campos legados weight_kg / height_cm /
        width_cm / length_cm foram removidos da criação — use packages.
      properties:
        id:
          type: integer
          readOnly: true
        product:
          type: integer
        title:
          type: string
          description: Título do anúncio
          maxLength: 150
        price:
          type: string
          format: decimal
          pattern: ^-?\d{0,8}(?:\.\d{0,2})?$
        brand:
          type: integer
        quantity:
          type: integer
          maximum: 2147483647
          minimum: 0
        description:
          type: string
          maxLength: 255
        condition:
          type: integer
        shipping_method:
          allOf:
          - $ref: '#/components/schemas/ShippingMethodEnum'
          default: both
          description: |-
            Método de envio aceito para este anúncio. 'in_person' = somente entrega presencial; 'melhor_envio' = somente via transportadora Melhor Envio; 'both' = ambos os métodos são aceitos (padrão).

            * `in_person` - Somente Entrega Presencial
            * `melhor_envio` - Somente Melhor Envio
            * `both` - Ambos (Presencial e Melhor Envio)
      required:
      - brand
      - condition
      - description
      - id
      - price
      - product
      - title
    MarketplaceListingCreateRequest:
      type: object
      description: |-
        Serializer para criar listagem.

        O campo `packages` é obrigatório e deve conter pelo menos 1 pacote com
        as dimensões físicas do produto. Os campos legados weight_kg / height_cm /
        width_cm / length_cm foram removidos da criação — use packages.
      properties:
        product:
          type: integer
        title:
          type: string
          minLength: 1
          description: Título do anúncio
          maxLength: 150
        price:
          type: string
          format: decimal
          pattern: ^-?\d{0,8}(?:\.\d{0,2})?$
        brand:
          type: integer
        quantity:
          type: integer
          maximum: 2147483647
          minimum: 0
        description:
          type: string
          minLength: 1
          maxLength: 255
        condition:
          type: integer
        packages:
          type: array
          items:
            $ref: '#/components/schemas/ListingPackageRequest'
          writeOnly: true
          description: Lista de pacotes físicos do produto. Deve conter pelo menos
            1 pacote.
        shipping_method:
          allOf:
          - $ref: '#/components/schemas/ShippingMethodEnum'
          default: both
          description: |-
            Método de envio aceito para este anúncio. 'in_person' = somente entrega presencial; 'melhor_envio' = somente via transportadora Melhor Envio; 'both' = ambos os métodos são aceitos (padrão).

            * `in_person` - Somente Entrega Presencial
            * `melhor_envio` - Somente Melhor Envio
            * `both` - Ambos (Presencial e Melhor Envio)
      required:
      - brand
      - condition
      - description
      - packages
      - price
      - product
      - title
    MarketplaceListingDetail:
      type: object
      description: Serializer detalhado de listagem
